import { useEffect, useRef, useState } from "react";
import { useNavigate } from "react-router-dom";
import api from "../services/api";

function Register() {
  const navigate = useNavigate();
  const videoRef = useRef(null);
  const streamRef = useRef(null);
  const faceBlobRef = useRef(null);

  const [activeTab, setActiveTab] = useState(0);
  const [name, setName] = useState("");
  const [voterNumber, setVoterNumber] = useState("");
  const [dob, setDob] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [cameraReady, setCameraReady] = useState(false);
  const [dobVerified, setDobVerified] = useState(false);
  const [voterCreated, setVoterCreated] = useState(false);
  const [passkeyRegistered, setPasskeyRegistered] = useState(false);
  const [passkeyLoading, setPasskeyLoading] = useState(false);
  const [registering, setRegistering] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function startCamera() {
      try {
        if (!navigator.mediaDevices?.getUserMedia) {
          throw new Error(
            "Camera access is unavailable. Use a compatible browser on localhost or HTTPS."
          );
        }

        const stream = await navigator.mediaDevices.getUserMedia({
          video: {
            width: { ideal: 640 },
            height: { ideal: 480 },
            facingMode: "user",
          },
          audio: false,
        });

        if (cancelled) {
          stream.getTracks().forEach((track) => track.stop());
          return;
        }

        streamRef.current = stream;
        if (videoRef.current) {
          await attachCameraStream(videoRef.current, stream);
          setCameraReady(true);
        }
      } catch (err) {
        console.error("Camera error:", err);
        if (!cancelled) {
          setCameraReady(false);
          setError(err.message || "Unable to access the camera. Check browser permissions.");
        }
      }
    }

    startCamera();
    return () => {
      cancelled = true;
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((track) => track.stop());
        streamRef.current = null;
      }
    };
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function attachWhenVisible() {
      if (activeTab !== 1) return;
      const video = videoRef.current;
      const stream = streamRef.current;
      if (!video || !stream) {
        setCameraReady(false);
        return;
      }

      try {
        await attachCameraStream(video, stream);
        if (!cancelled) {
          setCameraReady(true);
          setError("");
        }
      } catch (err) {
        console.error("Camera preview error:", err);
        if (!cancelled) {
          setCameraReady(false);
          setError(err.message || "Camera preview could not start.");
        }
      }
    }

    attachWhenVisible();
    return () => {
      cancelled = true;
    };
  }, [activeTab]);

  function stopCamera() {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setCameraReady(false);
  }

  async function captureFace() {
    const video = videoRef.current;
    if (!video || video.readyState < 2 || !video.videoWidth) {
      throw new Error("Camera is not ready. Wait for the preview and try again.");
    }

    const canvas = document.createElement("canvas");
    const scale = Math.min(1, 640 / video.videoWidth);
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);

    const context = canvas.getContext("2d");
    if (!context) throw new Error("Unable to process the camera image.");
    context.drawImage(video, 0, 0, canvas.width, canvas.height);

    const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
    if (!blob) throw new Error("Unable to capture the face image.");
    return blob;
  }

  function validateDetails() {
    if (!name.trim() || !voterNumber.trim() || !dob) {
      setError("Enter your name, voter number, and date of birth.");
      return false;
    }

    if (email.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
      setError("Enter a valid email address or leave it blank.");
      return false;
    }

    if (password && password.length < 8) {
      setError("If you choose a password, it must contain at least 8 characters.");
      return false;
    }

    const selectedDob = new Date(`${dob}T00:00:00`);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (Number.isNaN(selectedDob.getTime()) || selectedDob > today) {
      setError("Enter a valid date of birth that is not in the future.");
      return false;
    }
    return true;
  }

  function nextToFace() {
    setError("");
    if (validateDetails()) setActiveTab(1);
  }

  async function nextToPasskey() {
    setError("");
    if (!validateDetails()) {
      setActiveTab(0);
      return;
    }
    if (!cameraReady) {
      setError("Wait until the camera preview is ready.");
      return;
    }
    try {
      faceBlobRef.current = await captureFace();
      setActiveTab(2);
    } catch (err) {
      console.error("Face capture error:", err);
      setError(err.message || "Unable to capture the face image.");
    }
  }

  function decodeBase64Url(value) {
    const base64 = value.replace(/-/g, "+").replace(/_/g, "/");
    const padded = base64 + "=".repeat((4 - (base64.length % 4)) % 4);
    return Uint8Array.from(atob(padded), (character) => character.charCodeAt(0));
  }

  function encodeBase64Url(buffer) {
    const bytes = new Uint8Array(buffer);
    let binary = "";
    bytes.forEach((byte) => {
      binary += String.fromCharCode(byte);
    });
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
  }

  async function createVoterIfNeeded() {
    if (voterCreated) return;

    const faceBlob = faceBlobRef.current;
    if (!faceBlob) {
      throw new Error("No face image captured. Return to Face Registration and try again.");
    }

    const formData = new FormData();
    formData.append("name", name.trim());
    formData.append("voter_number", voterNumber.trim());
    formData.append("dob", dob);
    formData.append("file", faceBlob, "face.jpg");
    if (email.trim()) formData.append("email", email.trim().toLowerCase());
    if (password) formData.append("password", password);

    const response = await api.post("/register", formData);
    if (response.data?.success !== true) {
      throw new Error(response.data?.message || "Voter registration failed.");
    }
    setVoterCreated(true);
  }

  async function handlePasskeyRegistration() {
    setError("");
    if (!validateDetails()) {
      setActiveTab(0);
      return;
    }
    if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) {
      setError("Passkeys are not supported in this browser context. Use a compatible browser on localhost or HTTPS.");
      return;
    }
    if (!faceBlobRef.current) {
      setError("Face image is missing. Return to Face Registration and capture it again.");
      setActiveTab(1);
      return;
    }

    setPasskeyLoading(true);
    try {
      // The current backend requires the voter record before passkey options are requested.
      await createVoterIfNeeded();

      const optionsResponse = await api.post("/passkey/register/options", {
        voter_number: voterNumber.trim(),
      });
      const options = optionsResponse.data?.publicKey;
      if (!options?.challenge || !options?.user?.id) {
        throw new Error("The backend did not return valid passkey registration options.");
      }

      options.challenge = decodeBase64Url(options.challenge);
      options.user.id = decodeBase64Url(options.user.id);
      if (options.excludeCredentials) {
        options.excludeCredentials = options.excludeCredentials.map((credential) => ({
          ...credential,
          id: decodeBase64Url(credential.id),
        }));
      }

      const credential = await navigator.credentials.create({ publicKey: options });
      if (!credential) throw new Error("Passkey registration was cancelled.");

      const credentialData = {
        id: credential.id,
        rawId: encodeBase64Url(credential.rawId),
        type: credential.type,
        response: {
          clientDataJSON: encodeBase64Url(credential.response.clientDataJSON),
          attestationObject: encodeBase64Url(credential.response.attestationObject),
        },
        clientExtensionResults: credential.getClientExtensionResults(),
      };

      const verifyResponse = await api.post("/passkey/register/verify", {
        voter_number: voterNumber.trim(),
        credential: credentialData,
      });

      if (verifyResponse.data?.success !== true) {
        throw new Error(verifyResponse.data?.message || "The server did not confirm passkey registration.");
      }

      setPasskeyRegistered(true);
      setError("");
    } catch (err) {
      console.error("Passkey registration error:", err);
      setPasskeyRegistered(false);
      const detail = err.response?.data?.detail;
      setError(typeof detail === "string" ? detail : err.message || "Passkey registration failed.");
    } finally {
      setPasskeyLoading(false);
    }
  }

  async function handleRegister(event) {
    event.preventDefault();
    setError("");
    if (registering) return;

    if (!voterCreated) {
      setError("Create the voter account first using Register Fingerprint / Passkey.");
      setActiveTab(2);
      return;
    }
    if (!passkeyRegistered) {
      setError("The voter account exists, but passkey registration is incomplete. Retry passkey registration.");
      setActiveTab(2);
      return;
    }

    setRegistering(true);
    try {
      stopCamera();
      alert("Voter and passkey registration completed successfully.");
      navigate("/");
    } finally {
      setRegistering(false);
    }
  }

  const tabs = ["Personal Details", "Face Registration", "Fingerprint / Passkey"];

  return (
    <div className="page">
      <div style={{ width: "100%", maxWidth: "900px", margin: "0 auto", padding: "30px 20px 50px", boxSizing: "border-box" }}>
        <header style={{ textAlign: "center", marginBottom: "28px" }}>
          <h1 style={{ fontSize: "34px", marginBottom: "8px" }}>Voter Registration</h1>
          <p style={{ opacity: 0.8 }}>Complete the required steps to register your account.</p>
        </header>

        <div style={tabsStyle}>
          {tabs.map((tab, index) => (
            <button
              key={tab}
              type="button"
              onClick={() => { setError(""); setActiveTab(index); }}
              aria-current={activeTab === index ? "step" : undefined}
              style={{ ...tabButtonStyle, background: activeTab === index ? "#1683ff" : "#0b1c30" }}
            >
              {index + 1}. {tab}
            </button>
          ))}
        </div>

        <div style={cardStyle}>
          <form onSubmit={handleRegister}>
            {activeTab === 0 && (
              <section>
                <h2>Personal Details</h2>
                <div style={gridStyle}>
                  <Field label="Full Name *">
                    <input style={inputStyle} value={name} onChange={(event) => setName(event.target.value)} autoComplete="name" required />
                  </Field>
                  <Field label="Voter Number *">
                    <input style={inputStyle} value={voterNumber} onChange={(event) => setVoterNumber(event.target.value)} required />
                  </Field>
                  <Field label="Date of Birth *">
                    <input style={{ ...inputStyle, colorScheme: "dark" }} type="date" value={dob} max={getTodayDate()} onChange={(event) => { setDob(event.target.value); setDobVerified(false); }} required />
                  </Field>
                  <Field label="Email Address (Optional)">
                    <input style={inputStyle} type="email" value={email} onChange={(event) => setEmail(event.target.value)} autoComplete="email" />
                  </Field>
                  <Field label="Password (Optional)">
                    <input style={inputStyle} type="password" value={password} onChange={(event) => setPassword(event.target.value)} autoComplete="new-password" minLength={password ? 8 : undefined} />
                    <small style={{ opacity: 0.75 }}>If provided, use at least 8 characters.</small>
                  </Field>
                </div>

                <div style={noticeStyle}>
                  <strong>DOB validation — demonstration only</strong>
                  <p>This checks the entered date format and whether the date is in the past. It does not verify identity against Aadhaar, UIDAI, or an official voter database.</p>
                  <button type="button" style={secondaryButtonStyle} onClick={() => { setError(""); if (validateDetails()) setDobVerified(true); }}>Validate Entered Details</button>
                  {dobVerified && <p role="status" style={{ color: "#5ee879" }}>Entered details passed basic form validation.</p>}
                </div>
                <button type="button" style={primaryButtonStyle} onClick={nextToFace}>Continue to Face Registration</button>
              </section>
            )}

            {activeTab === 1 && (
              <section>
                <h2>Face Registration</h2>
                <p style={{ opacity: 0.8, lineHeight: 1.6 }}>Position your face in the camera view. A still image will be captured and submitted to the backend when you register.</p>
                <video ref={videoRef} autoPlay muted playsInline aria-label="Live camera preview" style={{ display: "block", width: "100%", maxWidth: "640px", aspectRatio: "4 / 3", objectFit: "cover", objectPosition: "center", margin: "18px auto", borderRadius: "14px", border: cameraReady ? "3px solid #2196f3" : "3px solid #29415c", background: "#06111e" }} />
                <p role="status" style={{ textAlign: "center", color: cameraReady ? "#5ee879" : "#ffd45c" }}>{cameraReady ? "Camera preview active" : "Starting camera preview…"}</p>
                <div style={buttonRowStyle}>
                  <button type="button" style={secondaryButtonStyle} onClick={() => { setError(""); setActiveTab(0); }}>Back</button>
                  <button type="button" style={primaryButtonStyle} onClick={nextToPasskey} disabled={!cameraReady}>Capture Face & Continue</button>
                </div>
                {faceBlobRef.current && <p role="status" style={{ color: "#5ee879" }}>A face image has been captured for this registration attempt.</p>}
              </section>
            )}

            {activeTab === 2 && (
              <section>
                <h2>Fingerprint / Passkey Registration</h2>
                <div style={noticeStyle}>
                  <strong>Authenticate with your device</strong>
                  <p>Register a device passkey. Depending on your device, this may use a fingerprint, face recognition, or device PIN. The website does not receive your raw fingerprint.</p>
                  <button type="button" style={primaryButtonStyle} disabled={passkeyLoading || passkeyRegistered} onClick={handlePasskeyRegistration}>
                    {passkeyLoading ? "Registering voter and waiting for device…" : passkeyRegistered ? "Passkey Registered" : voterCreated ? "Retry Passkey Registration" : "Create Voter & Register Passkey"}
                  </button>
                  <p role="status" style={{ color: passkeyRegistered ? "#5ee879" : "inherit" }}>
                    {passkeyRegistered ? "The server confirmed passkey registration." : voterCreated ? "Voter account created. Complete passkey registration to finish." : "Your voter and face details will be saved before passkey registration starts."}
                  </p>
                </div>

                <div style={noticeStyle}>
                  <strong>Registration information</strong>
                  <p>Email and password are optional in this prototype. Use only synthetic demo details for testing.</p>
                </div>

                <div style={buttonRowStyle}>
                  <button type="button" style={secondaryButtonStyle} onClick={() => { setError(""); setActiveTab(1); }}>Back</button>
                  <button type="submit" disabled={registering || !voterCreated || !passkeyRegistered} style={{ ...primaryButtonStyle, opacity: registering || !voterCreated || !passkeyRegistered ? 0.55 : 1, cursor: registering || !voterCreated || !passkeyRegistered ? "not-allowed" : "pointer" }}>
                    {registering ? "Completing Registration…" : "Complete Registration"}
                  </button>
                </div>
              </section>
            )}

            {error && <div role="alert" style={errorStyle}>{error}</div>}
          </form>
        </div>
      </div>
    </div>
  );
}

async function attachCameraStream(video, stream) {
  if (!video || !stream) throw new Error("Camera preview is not available yet.");
  if (video.srcObject !== stream) video.srcObject = stream;
  video.muted = true;
  video.playsInline = true;
  await video.play();

  if (!video.videoWidth || !video.videoHeight) {
    await new Promise((resolve, reject) => {
      const timeout = window.setTimeout(() => {
        cleanup();
        reject(new Error("Camera started but no video frames arrived."));
      }, 5000);
      function cleanup() {
        window.clearTimeout(timeout);
        video.removeEventListener("loadeddata", onLoaded);
        video.removeEventListener("error", onError);
      }
      function onLoaded() { cleanup(); resolve(); }
      function onError() { cleanup(); reject(new Error("The browser could not display the camera preview.")); }
      video.addEventListener("loadeddata", onLoaded, { once: true });
      video.addEventListener("error", onError, { once: true });
    });
  }
  if (!video.videoWidth || !video.videoHeight) throw new Error("Camera started but no video frames arrived.");
}

function Field({ label, children }) {
  return (
    <div>
      <label style={{ display: "block", marginBottom: "8px", fontWeight: "600" }}>{label}</label>
      {children}
    </div>
  );
}

function getTodayDate() {
  const today = new Date();
  const year = today.getFullYear();
  const month = String(today.getMonth() + 1).padStart(2, "0");
  const day = String(today.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

const tabsStyle = { display: "flex", flexWrap: "wrap", gap: "8px", marginBottom: "18px" };
const tabButtonStyle = { flex: "1 1 150px", padding: "13px 10px", borderRadius: "9px", border: "1px solid #29415c", color: "white", fontWeight: "600", cursor: "pointer" };
const cardStyle = { background: "#0b1c30", border: "1px solid #29415c", borderRadius: "16px", padding: "28px", boxShadow: "0 10px 30px rgba(0,0,0,0.25)" };
const gridStyle = { display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(240px, 1fr))", gap: "20px" };
const inputStyle = { width: "100%", boxSizing: "border-box", padding: "13px 14px", borderRadius: "8px", border: "1px solid #3d5873", background: "#071526", color: "white", fontSize: "15px" };
const noticeStyle = { marginTop: "22px", padding: "16px", borderRadius: "10px", border: "1px solid #29415c", background: "#071526", lineHeight: 1.6 };
const primaryButtonStyle = { width: "100%", marginTop: "22px", padding: "14px", border: "none", borderRadius: "9px", background: "#1683ff", color: "white", fontSize: "16px", fontWeight: "700", cursor: "pointer" };
const secondaryButtonStyle = { padding: "12px 16px", border: "1px solid #3d5873", borderRadius: "8px", background: "#122941", color: "white", fontWeight: "600", cursor: "pointer" };
const buttonRowStyle = { display: "flex", flexWrap: "wrap", gap: "12px", alignItems: "center" };
const errorStyle = { marginTop: "20px", padding: "12px 15px", borderRadius: "8px", background: "rgba(220, 53, 69, 0.12)", border: "1px solid rgba(220, 53, 69, 0.4)", color: "#ff7b87", fontWeight: "600" };

export default Register;
