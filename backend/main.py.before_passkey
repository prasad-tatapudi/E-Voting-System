@app.post("/api/eligibility")

def check_eligibility(

    voter_id: int,

    db: Session = Depends(get_db),

):

    voter = (

        db.query(Voter)

        .filter(Voter.id == voter_id)

        .first()

    )

    if not voter:

        return {

            "success": False,

            "eligible": False,

            "message": "Voter account not found.",

        }

    if voter.dob is None:

        return {

            "success": True,

            "eligible": False,

            "message": "Date of birth is missing.",

        }

    if calculate_age(voter.dob) < MINIMUM_VOTING_AGE:

        voter.is_eligible = False

        db.commit()

        return {

            "success": True,

            "eligible": False,

            "message": "The minimum voting age requirement is not met.",

        }

    if voter.has_voted:

        return {

            "success": True,

            "eligible": False,

            "message": "You have already voted.",

        }

    # This is prototype eligibility based on the stored DOB.

    # Official eligibility requires authoritative verification.

    voter.is_eligible = True

    db.commit()

    return {

        "success": True,

        "eligible": True,

        "message": "Age requirement passed in this prototype.",

        "voter_id": voter.id,

    }

