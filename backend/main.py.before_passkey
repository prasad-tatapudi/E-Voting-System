@app.post("/api/passkey/register/options")
def passkey_registration_options(
    data: PasskeyOptionsRequest,
    db: Session = Depends(get_db),
):
    """
    Start passkey registration for an EXISTING voter.
    The voter must already be saved in the database.
    """
    voter_number = data.voter_number.strip()
    voter = (
        db.query(Voter)
        .filter(Voter.voter_number == voter_number)
        .first()
    )
    if not voter:
        raise HTTPException(
            status_code=404,
            detail=(
                "Voter account not found. Save the voter account before "
                "registering a passkey."
            ),
        )

    existing_credentials = (
        db.query(PasskeyCredential)
        .filter(PasskeyCredential.voter_id == voter.id)
        .all()
    )
    exclude_credentials = []
    for item in existing_credentials:
        try:
            exclude_credentials.append(
                PublicKeyCredentialDescriptor(
                    id=base64url_to_bytes(item.credential_id)
                )
            )
        except Exception:
            # A malformed stored credential should not crash the endpoint.
            continue

    options = generate_registration_options(
        rp_id=WEBAUTHN_RP_ID,
        rp_name=WEBAUTHN_RP_NAME,
        user_id=str(voter.id).encode("utf-8"),
        user_name=voter.voter_number,
        user_display_name=voter.name,
        exclude_credentials=exclude_credentials,
        authenticator_selection=AuthenticatorSelectionCriteria(
            user_verification=UserVerificationRequirement.REQUIRED,
        ),
    )

    now = datetime.now(timezone.utc)
    challenge_row = (
        db.query(PasskeyChallenge)
        .filter(PasskeyChallenge.voter_id == voter.id)
        .first()
    )
    challenge_value = bytes_to_base64url(options.challenge)

    try:
        if challenge_row:
            challenge_row.challenge = challenge_value
            challenge_row.created_at = now
        else:
            db.add(
                PasskeyChallenge(
                    voter_id=voter.id,
                    challenge=challenge_value,
                    created_at=now,
                )
            )
        db.commit()
    except Exception as error:
        db.rollback()
        print("PASSKEY CHALLENGE ERROR:", str(error))
        raise HTTPException(
            status_code=500,
            detail="Could not start passkey registration.",
        )

    return json.loads(options_to_json(options))


@app.post("/api/passkey/register/verify")
def verify_passkey_registration(
    data: PasskeyVerifyRequest,
    db: Session = Depends(get_db),
):
    """
    Verify a browser WebAuthn registration response and save its public key.
    A valid, recent challenge is required.
    """
    voter_number = data.voter_number.strip()
    voter = (
        db.query(Voter)
        .filter(Voter.voter_number == voter_number)
        .first()
    )
    if not voter:
        raise HTTPException(
            status_code=404,
            detail="Voter account not found.",
        )

    challenge_row = (
        db.query(PasskeyChallenge)
        .filter(PasskeyChallenge.voter_id == voter.id)
        .first()
    )
    if not challenge_row:
        raise HTTPException(
            status_code=400,
            detail="No passkey registration challenge found. Try again.",
        )

    created_at = challenge_row.created_at
    if created_at.tzinfo is None:
        created_at = created_at.replace(tzinfo=timezone.utc)

    if datetime.now(timezone.utc) - created_at > PASSKEY_CHALLENGE_TTL:
        db.delete(challenge_row)
        db.commit()
        raise HTTPException(
            status_code=400,
            detail="Passkey registration expired. Please try again.",
        )

    try:
        verification = verify_registration_response(
            credential=data.credential,
            expected_challenge=base64url_to_bytes(challenge_row.challenge),
            expected_rp_id=WEBAUTHN_RP_ID,
            expected_origin=WEBAUTHN_ORIGIN,
            require_user_verification=True,
        )
    except Exception as error:
        print("PASSKEY VERIFICATION ERROR:", str(error))
        raise HTTPException(
            status_code=400,
            detail="Passkey verification failed. Please try again.",
        )

    credential_id = bytes_to_base64url(verification.credential_id)
    public_key = bytes_to_base64url(verification.credential_public_key)

    try:
        existing = (
            db.query(PasskeyCredential)
            .filter(PasskeyCredential.credential_id == credential_id)
            .first()
        )
        if existing:
            raise HTTPException(
                status_code=409,
                detail="This passkey is already registered.",
            )

        db.add(
            PasskeyCredential(
                voter_id=voter.id,
                credential_id=credential_id,
                public_key=public_key,
                sign_count=verification.sign_count,
            )
        )
        db.delete(challenge_row)
        db.commit()
    except HTTPException:
        db.rollback()
        raise
    except Exception as error:
        db.rollback()
        print("PASSKEY SAVE ERROR:", str(error))
        raise HTTPException(
            status_code=500,
            detail="Passkey credential could not be saved.",
        )

    return {
        "success": True,
        "message": "Passkey registered successfully.",
        "voter_id": voter.id,
    }

